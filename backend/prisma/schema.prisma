generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PROCESSING
  DELIVERED
  CANCELLED
}

enum DiscrepancyType {
  SHORTAGE
  DAMAGED
}

enum CaseStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

enum DecisionType {
  APPROVE
  REJECT
}

enum CaseEventType {
  CREATED
  DECIDED
  ASSIGNED
  ASSIGNMENT_RELEASED
}

model Operator {
  id             String            @id @default(uuid()) @db.Uuid
  fullName       String            @map("full_name") @db.VarChar(120)
  email          String            @unique @db.VarChar(254)
  passwordHash   String?           @map("password_hash") @db.VarChar(255)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  createdCases   DiscrepancyCase[] @relation("CaseCreator")
  assignedCases  DiscrepancyCase[] @relation("CaseAssignee")
  decisions      CaseDecision[]    @relation("DecisionActor")
  historyEntries CaseHistory[]     @relation("HistoryActor")

  @@map("operators")
}

model Customer {
  id           String   @id @default(uuid()) @db.Uuid
  customerCode String   @unique @map("customer_code") @db.VarChar(24)
  fullName     String   @map("full_name") @db.VarChar(160)
  phone        String   @unique @db.VarChar(16)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  orders       Order[]

  @@map("customers")
}

model Order {
  id          String            @id @default(uuid()) @db.Uuid
  orderNumber String            @unique @map("order_number") @db.VarChar(32)
  customerId  String            @map("customer_id") @db.Uuid
  status      OrderStatus
  deliveredAt DateTime?         @map("delivered_at") @db.Timestamptz(3)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  customer    Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items       OrderItem[]
  cases       DiscrepancyCase[]

  @@index([customerId, status])
  @@map("orders")
}

model OrderItem {
  id                String            @id @default(uuid()) @db.Uuid
  orderId           String            @map("order_id") @db.Uuid
  sku               String            @db.VarChar(48)
  productName       String            @map("product_name") @db.VarChar(240)
  unit              String            @db.VarChar(24)
  deliveredQuantity Int               @map("delivered_quantity")
  order             Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  discrepancyItems  DiscrepancyItem[]
  openDiscrepancies OpenDiscrepancy[]

  @@unique([orderId, sku])
  @@map("order_items")
}

model DiscrepancyCase {
  id                String            @id @default(uuid()) @db.Uuid
  caseNumber        String            @unique @map("case_number") @db.VarChar(32)
  orderId           String            @map("order_id") @db.Uuid
  status            CaseStatus        @default(SUBMITTED)
  createdById       String            @map("created_by_id") @db.Uuid
  assigneeId        String?           @map("assignee_id") @db.Uuid
  assignedAt        DateTime?         @map("assigned_at") @db.Timestamptz(3)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  order             Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  createdBy         Operator          @relation("CaseCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignee          Operator?         @relation("CaseAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  items             DiscrepancyItem[]
  decision          CaseDecision?
  history           CaseHistory[]
  openDiscrepancies OpenDiscrepancy[]

  @@index([status, createdAt])
  @@index([orderId])
  @@index([assigneeId, status, createdAt])
  @@map("discrepancy_cases")
}

model DiscrepancyItem {
  id          String          @id @default(uuid()) @db.Uuid
  caseId      String          @map("case_id") @db.Uuid
  orderItemId String          @map("order_item_id") @db.Uuid
  type        DiscrepancyType
  quantity    Int
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  case        DiscrepancyCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  orderItem   OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@unique([caseId, orderItemId, type])
  @@index([orderItemId])
  @@map("discrepancy_items")
}

model OpenDiscrepancy {
  orderItemId String          @map("order_item_id") @db.Uuid
  type        DiscrepancyType
  caseId      String          @map("case_id") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  orderItem   OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  case        DiscrepancyCase @relation(fields: [caseId], references: [id], onDelete: Restrict)

  @@id([orderItemId, type])
  @@index([caseId])
  @@map("open_discrepancies")
}

model CaseDecision {
  id          String          @id @default(uuid()) @db.Uuid
  caseId      String          @unique @map("case_id") @db.Uuid
  type        DecisionType
  explanation String          @db.Text
  decidedById String          @map("decided_by_id") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  case        DiscrepancyCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  decidedBy   Operator        @relation("DecisionActor", fields: [decidedById], references: [id], onDelete: Restrict)

  @@map("case_decisions")
}

model CaseHistory {
  id              String          @id @default(uuid()) @db.Uuid
  caseId          String          @map("case_id") @db.Uuid
  eventType       CaseEventType   @map("event_type")
  resultingStatus CaseStatus      @map("resulting_status")
  performedById   String          @map("performed_by_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  case            DiscrepancyCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  performedBy     Operator        @relation("HistoryActor", fields: [performedById], references: [id], onDelete: Restrict)

  @@index([caseId, createdAt])
  @@map("case_history")
}
