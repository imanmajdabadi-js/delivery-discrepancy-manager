{
  "name": "delivery-discrepancy-manager",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20.20.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @delivery-discrepancy/web --filter @delivery-discrepancy/api dev",
    "db:start": "docker compose up -d --wait database",
    "db:stop": "docker compose stop database",
    "db:setup": "pnpm db:start && pnpm --filter @delivery-discrepancy/api db:deploy && pnpm db:seed && pnpm db:verify",
    "db:seed": "pnpm --filter @delivery-discrepancy/api db:seed",
    "db:verify": "pnpm --filter @delivery-discrepancy/api db:verify",
    "build": "pnpm -r --if-present build",
    "lint": "oxlint frontend/src backend/src",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "oxlint": "^1.73.0",
    "prettier": "^3.9.5"
  }
}
